# Copy this file to .env.production (repo root) and fill in the values below.
# .env.production is gitignored — never commit real keys.
#
# Used only by scripts/analytics-report.mjs (npm run analytics:report) — deliberately
# separate from .env.local so pointing this at prod once never requires touching whatever
# you use .env.local for. Point it at dev instead if you're testing the pipeline itself.

# Prod:  https://fsfsqghbejwvgxujoyne.supabase.co
# Dev:   https://aejywkbkcwyanhyzhrle.supabase.co
SUPABASE_URL=

# Dashboard → Project Settings → API → service_role secret key. This key bypasses RLS —
# treat it like a root password. Never paste it in chat, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
